---
import Layout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader";
import TagChip from "@/components/TagChip";
import { allPosts, allTags, getTagCounts } from "@/lib/posts";

const tagCounts = getTagCounts(allPosts);

const description = "浏览 Elysium 博客的所有文章标签，方便查找感兴趣的内容。";
---

<Layout pageTitle="所有标签" description={description}>
    <div class="page-wide">
        <PageHeader eyebrow="All Tags" title="所有标签" count={`共 ${allTags.length} 个标签`}/>

        <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
            {allTags.map((tag) => (
                    <div class="flex flex-col gap-2 items-center">
                        <TagChip tag={tag} icon/>
                        <span class="text-muted-foreground bg-accent/50 px-2 py-0.5 rounded-full text-xs">
                            {tagCounts.get(tag) ?? 0} 篇
                        </span>
                    </div>
            ))}
        </div>
    </div>
</Layout>
