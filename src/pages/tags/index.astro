---
import Layout from "@/layouts/Layout.astro";
import {allPosts, allTags, getTagCounts} from "@/lib/blog";
import TagsList from "@/components/TagsList";

const tagCounts = getTagCounts(allPosts);
const items = allTags.map((tag) => ({
    tag, count: tagCounts.get(tag) ?? 0, searchable: tag.toLowerCase(),
}));

const description = "浏览 Elysium 博客的所有文章标签，方便查找感兴趣的内容。";

---

<Layout pageTitle="所有标签" description={description}>
    <main class="page-container">
        <section class="mb-10 pb-10 border-b border-border">
            <p
                    class="section-label mb-3"
            >
                All Tags
            </p>
            <h1
                    class="text-4xl tracking-tight font-normal font-serif mb-2 lg:text-5xl"
            >
                所有标签
            </h1>
            <p class="text-sm text-muted-foreground">共 {allTags.length} 个标签</p>
        </section>
        <TagsList client:visible items={items}/>
    </main>
</Layout>
