---
import Layout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader";
import PostList from "@/components/PostList";
import { allTags, sortedPosts, toSummary, type Post } from "@/lib/posts";

export async function getStaticPaths() {
    return allTags.map((tag) => ({
        params: {tag},
        props: {posts: sortedPosts.filter((post) => post.data.tags.includes(tag))},
    }));
}

const tag = Astro.params.tag ?? "";
const {posts} = Astro.props as { posts: Post[] };
const summaries = posts.map(toSummary);
const total = summaries.length;
const description = `查看标签 #${tag} 下的所有文章，共 ${total} 篇。`;
---

<Layout pageTitle={`#${tag} 相关文章`} description={description}>
    <div class="page-wide">
        <a
                href="/tags"
                class="back-link mb-8"
        >
            <span class="i-mdi-arrow-left h-3.5 w-3.5" aria-hidden="true"></span>
            全部标签
        </a>

        <PageHeader eyebrow="Tag" title={tag} count={`共 ${total} 篇`}/>

        <PostList posts={summaries}/>
    </div>
</Layout>
