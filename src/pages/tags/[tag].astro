---
import Layout from "@/layouts/Layout.astro";
import {
    sortedPosts, allTags as uniqueTags, type Post, formatDate,
} from "@/lib/blog";

export async function getStaticPaths() {
    return uniqueTags.map((tag) => {
        const posts = sortedPosts.filter((post) => post.data.tags.includes(tag),);

        return {
            params: {tag}, props: {posts},
        };
    });
}

const {tag} = Astro.params;
const {posts} = Astro.props as { posts: Post[] };
const total = posts.length;
const description = `查看标签 #${tag} 下的所有文章，共 ${total} 篇。`;
const getTags = (post: Post) => post.data.tags.slice(0, 3);
const isActive = (t: string) => t === tag;
---

<Layout pageTitle={`#${tag} 相关文章`} description={description}>
    <div class="mx-auto px-6 py-12 max-w-5xl">
        <!-- back -->
        <a
                href="/tags"
                class="back-link mb-8"
        >
            <span class="i-mdi-arrow-left h-3.5 w-3.5"></span>
            全部标签
        </a>
        <section class="mb-10 pb-10 border-b border-border">
            <p
                    class="section-label mb-3"
            >
                Tag
            </p>
            <div class="mb-2 flex gap-2.5 items-center">
                <span class="i-mdi-tag text-muted-foreground shrink-0 h-5 w-5"
                ></span>
                <h1 class="text-4xl tracking-tight font-serif lg:text-5xl">
                    {tag}
                </h1>
            </div>
            <p class="text-sm text-muted-foreground">
                共 {total} 篇文章
            </p>
        </section>
        <section
                class="divide-border divide-y"
                aria-label={`标签 ${tag} 下的文章`}
        >
            {posts.map((post) => {
                const tags = getTags(post);

                return (<a
                        href={`/blog/${post.id}`}
                        class="group px-3 py-4 rounded-sm flex gap-5 transition-colors items-baseline -mx-3 hover:bg-accent/20 focus-ring"
                        aria-label={`阅读 ${post.data.title}`}
                >
                    <time class="text-xs text-muted-foreground shrink-0 min-w-20 whitespace-nowrap tabular-nums">
                        {formatDate(post.data.pubDate)}
                    </time>
                    <div class="flex-1 min-w-0">
                        <h2 class="text-sm font-medium mb-1 truncate">
                            {post.data.title}
                        </h2>
                        <p class="text-xs text-muted-foreground leading-relaxed mb-2 truncate">
                            {post.data.description}
                        </p>
                        <div class="flex flex-wrap gap-1.5">
                            {tags.map((t) => (<span
                                    class={["text-xs px-2 py-0.5 rounded-full", isActive(t) ? "bg-foreground/10 text-foreground font-medium" : "bg-accent/50 text-muted-foreground",].join(" ")}
                            >
                                            {t}
                                        </span>))}
                        </div>
                    </div>
                    <span class="i-mdi-arrow-top-right text-xs text-muted-foreground opacity-0 shrink-0 transition-opacity group-hover:opacity-100"/>
                </a>);
            })}
        </section>
        <div class="mt-12 flex justify-center">
            <a
                    href="/tags"
                    class="text-sm text-muted-foreground px-5 py-2.5 border border-border rounded-md inline-flex gap-2 transition-colors items-center hover:text-foreground hover:border-foreground/30"
            >
                <span class="i-mdi-arrow-left h-4 w-4"></span>
                返回标签列表
            </a>
        </div>
    </div>
</Layout>
