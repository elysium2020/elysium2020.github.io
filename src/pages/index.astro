---
import Layout from "@/layouts/Layout.astro";

import ButtonLink from "@/components/ButtonLink";
import TagLink from "@/components/TagLink";
import PostItem from "@/components/PostItem.astro";
import LinkWithUnderline from "@/components/LinkWithUnderline";

import {sortedPosts, formatDate, getPopularTags} from "@/lib/blog";

const latestPosts = sortedPosts.slice(0, 4);
const popularTags = getPopularTags(sortedPosts, 8);

const siteTitle = "Elysium's Blog";
const siteDescription = "Elysium's personal blog.";
---

<Layout pageTitle={siteTitle} description={siteDescription}>
    <main class="page-container">
        <section class="mb-12 pb-12 border-b border-border">
            <p
                    class="section-label mb-4"
            >
                Personal Blog
            </p>

            <h1
                    class="text-4xl tracking-tight font-normal font-serif mb-5 lg:text-5xl"
            >
                {siteTitle}
            </h1>

            <p
                    class="text-base text-muted-foreground leading-relaxed mb-8 max-w-lg"
            >
                elysium的博客。
            </p>

            <div class="flex gap-2.5">
                <ButtonLink href="/blog" variant="primary">
                    <span class="i-mdi-book-open h-4 w-4" aria-hidden="true"
                    ></span>
                    浏览文章
                </ButtonLink>

                <ButtonLink href="/tags" variant="secondary">
                    <span class="i-mdi-tag-multiple h-4 w-4" aria-hidden="true"
                    ></span>
                    查看标签
                </ButtonLink>
            </div>
        </section>
        <section class="mb-16">
            <div class="mb-5 flex items-baseline justify-between">
                <h2
                        class="section-label"
                >
                    最新文章
                </h2>
                <LinkWithUnderline
                        href="/blog"
                        class="text-xs text-muted-foreground"
                >
                    <span class="group inline-flex gap-1 items-center">
                        全部
                        <span
                                class="i-mdi-arrow-right h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5"
                        ></span>
                    </span>
                </LinkWithUnderline>
            </div>

            <div class="flex flex-col">
                {latestPosts.map((post) => (
                        <PostItem post={post} formatDate={formatDate}/>))}
            </div>
            <section class="mt-12">
                <h2
                        class="section-label mb-5"
                >
                    热门标签
                </h2>

                <div class="flex flex-wrap gap-2">
                    {popularTags.map((tag) =>
                            <TagLink tag={tag}/>)}
                </div>
            </section>
        </section>
    </main>
</Layout>
