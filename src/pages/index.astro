---
import Layout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList";
import TagChip from "@/components/TagChip";
import { SITE, SOCIAL_LINKS } from "@/lib/site";
import { popularTags, sortedPosts, toSummary } from "@/lib/posts";

const latest = sortedPosts.slice(0, 4).map(toSummary);
---

<Layout pageTitle={SITE.title} description={SITE.description}>
    <div class="page-narrow">
        <section class="mb-12 border-b border-border pb-12">
            <p class="section-label mb-4">
                Personal Blog
            </p>

            <h1 class="text-4xl tracking-tight mb-5 lg:text-5xl">
                {SITE.title}
            </h1>

            <p class="text-base text-muted-foreground leading-relaxed mb-8 max-w-lg">
                {SITE.tagline}
            </p>

            <div class="flex flex-wrap gap-2.5">
                {SOCIAL_LINKS.map(({name, href, icon}) => (
                        <a
                                href={href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-muted-foreground border-border px-3 py-1.5 rounded-full border inline-flex gap-1.5 text-sm transition-colors items-center hover:text-foreground hover:border-foreground/40 focus-ring"
                        >
                            <span class={`${icon} shrink-0 h-4 w-4`} aria-hidden="true"/>
                            {name}
                        </a>
                ))}
            </div>
        </section>

        <section class="mb-16">
            <div class="mb-5 flex items-baseline justify-between">
                <h2 class="section-label">
                    最新文章
                </h2>
                <a
                        href="/blog"
                        class="text-muted-foreground text-xs inline-flex gap-1 transition-colors items-center hover:text-foreground"
                >
                    全部
                    <span class="i-mdi-arrow-right h-3.5 w-3.5" aria-hidden="true"/>
                </a>
            </div>

            <PostList posts={latest}/>

            <section class="mt-12">
                <h2 class="section-label mb-5">
                    热门标签
                </h2>

                <div class="flex flex-wrap gap-2">
                    {popularTags.map((tag) => <TagChip tag={tag}/>)}
                </div>
            </section>
        </section>
    </div>
</Layout>
