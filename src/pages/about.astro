---
import Layout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader";
import { SITE, SOCIAL_LINKS, STACK } from "@/lib/site";
---

<Layout
        pageTitle="About — Elysium"
        description="关于 Elysium，全栈 / DevOps 开发者。"
>
    <div class="page-narrow">
        <PageHeader eyebrow="About" title={SITE.author} count={SITE.tagline}/>

        <section aria-label="技术栈">
            <div class="divide-border divide-y">
                {STACK.map(({label, items}) => (
                        <div class="py-4 flex gap-8 items-start">
                            <span class="section-label pt-1 shrink-0 min-w-20">
                                {label}
                            </span>
                            <div class="flex flex-wrap gap-2">
                                {items.map(({name, icon}) => (
                                        <span class="text-muted-foreground bg-accent/50 px-2.5 py-1 border border-border rounded-full text-xs inline-flex gap-1.5 transition-colors items-center hover:text-foreground hover:border-foreground/20">
                                            <span class={`${icon} shrink-0 h-3.5 w-3.5`} aria-hidden="true"/>
                                            {name}
                                        </span>
                                ))}
                            </div>
                        </div>
                ))}

                {SOCIAL_LINKS.length > 0 && (
                        <div class="py-4 flex gap-8 items-start">
                            <span class="section-label pt-1 shrink-0 min-w-20">
                                Connect
                            </span>
                            <div class="flex flex-wrap gap-2">
                                {SOCIAL_LINKS.map(({name, href, icon}) => (
                                        <a
                                                href={href}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="text-muted-foreground px-2.5 py-1 border border-border rounded-full text-xs inline-flex gap-1.5 transition-all items-center hover:text-foreground hover:border-foreground/30 hover:-translate-y-0.5"
                                        >
                                            <span class={`${icon} shrink-0 h-3.5 w-3.5`} aria-hidden="true"/>
                                            {name}
                                        </a>
                                ))}
                            </div>
                        </div>
                )}
            </div>
        </section>
    </div>
</Layout>
