---
import Layout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader";
import Search from "@/components/islands/Search";
import { sortedPosts, toSummary } from "@/lib/posts";

const summaries = sortedPosts.map(toSummary);
const total = summaries.length;

const description = `浏览 Elysium 的所有博客文章，共 ${total} 篇，涵盖算法、技术心得等。`;
---

<Layout pageTitle="所有文章" description={description}>
    <div class="page-wide">
        <PageHeader eyebrow="All Posts" title="所有文章" count={`共 ${total} 篇`}/>

        <Search
            client:visible
            mode="posts"
            items={summaries}
            placeholder="搜索文章…"
            noun="篇文章"
        />
    </div>
</Layout>
