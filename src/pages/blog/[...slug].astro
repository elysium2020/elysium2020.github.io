---
import { render } from "astro:content";
import { Image } from "astro:assets";
import {
    allPosts,
    getRelated,
    sortedPosts,
    toSummary,
    type Post,
} from "@/lib/posts";
import { getPrevNext } from "@/lib/derive";
import Layout from "@/layouts/BaseLayout.astro";
import TagChip from "@/components/TagChip";
import PostList from "@/components/PostList";
import Toc from "@/components/islands/Toc";
import ReadingProgress from "@/components/islands/ReadingProgress";

export async function getStaticPaths() {
    return allPosts.map((post) => ({
        params: {slug: post.id}, props: {post},
    }));
}

const {post} = Astro.props as { post: Post };
const {Content, headings} = await render(post);

const summary = toSummary(post);
const related = getRelated(post, sortedPosts, 3).map(toSummary);
const {prev, next} = getPrevNext(post, sortedPosts);

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const tags = post.data.tags;
const hasTags = tags.length > 0;
---

<Layout
        pageTitle={post.data.title}
        description={post.data.description}
        type="article"
        publishedTime={post.data.pubDate}
        tags={post.data.tags}
        image={post.data.heroImage?.src}
>
    <ReadingProgress client:load/>
    <div class="mx-auto w-full max-w-5xl px-6 py-12">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem]">
            <div class="max-w-3xl min-w-0">
                <a href="/blog" class="back-link mb-10">
                    <span class="i-mdi-arrow-left h-3.5 w-3.5" aria-hidden="true"></span>
                    全部文章
                </a>

                {tocHeadings.length > 0 && (
                        <details class="lg:hidden mb-8">
                            <summary class="section-label cursor-pointer select-none">
                                本页目录
                            </summary>
                            <div class="mt-4"><Toc headings={tocHeadings}/></div>
                        </details>)}

                <article aria-label={post.data.title} data-pagefind-body>
                    <header class="mb-8">
                        {hasTags && (<p class="section-label mb-3">
                            {tags.slice(0, 3).join(" · ")}
                        </p>)}
                        <h1 class="text-4xl leading-tight tracking-tight mb-5 lg:text-5xl">
                            {post.data.title}
                        </h1>
                        <div class="text-xs text-muted-foreground pb-6 border-b border-border flex gap-4 items-center">
                            <span class="inline-flex gap-1.5 items-center">
                                <span class="i-mdi-calendar h-3.5 w-3.5"></span>
                                <time datetime={post.data.pubDate.toISOString()}>
                                    {summary.dateLabel}
                                </time>
                            </span>
                            <span class="inline-flex gap-1.5 items-center">
                                <span class="i-mdi-clock-outline h-3.5 w-3.5"></span>
                                约 {summary.readingMinutes} 分钟
                            </span>
                        </div>
                    </header>

                    {post.data.heroImage && (
                            <Image
                                    src={post.data.heroImage}
                                    alt={post.data.title}
                                    widths={[640, 960, 1280]}
                                    sizes="(min-width: 1024px) 720px, 100vw"
                                    loading="eager"
                                    class="mb-8 border border-border rounded-sm w-full"
                            />)}

                    <div
                            id="post-content"
                            class="max-w-none prose prose-zinc prose-lg prose-blockquote:text-muted-foreground prose-headings:font-normal prose-h2:pb-2 prose-blockquote:border-l-2 prose-h2:border-b prose-blockquote:border-border prose-h2:border-border prose-blockquote:not-italic dark:prose-invert"
                    >
                        <Content/>
                    </div>

                    {hasTags && (
                            <footer class="mt-12 pt-8 border-t border-border">
                                <div class="flex flex-wrap gap-2">
                                    {tags.map((tag) => <TagChip tag={tag} icon/>)}
                                </div>
                            </footer>)}
                </article>

                {related.length > 0 && (
                        <section class="mt-12" aria-label="相关文章">
                            <h2 class="section-label mb-3">相关文章</h2>
                            <PostList posts={related}/>
                        </section>)}

                <nav class="text-sm mt-12 flex gap-4 items-start justify-between" aria-label="文章导航">
                    <div class="flex-1 min-w-0">
                        {prev ? (<a
                                href={`/blog/${prev.id}/`}
                                class="group text-muted-foreground flex flex-col gap-1 transition-colors hover:text-foreground"
                        >
                            <span class="text-xs tracking-wider inline-flex gap-1 uppercase items-center">
                                <span class="i-mdi-arrow-left h-3 w-3"/>
                                上一篇
                            </span>
                            <span class="text-xs text-foreground font-medium truncate">
                                {prev.data.title}
                            </span>
                        </a>) : (<span class="text-xs text-muted-foreground/40 italic">
                            没有上一篇
                        </span>)}
                    </div>
                    <a
                            href="/blog"
                            class="text-muted-foreground px-2 flex shrink-0 flex-col gap-1 transition-colors items-center hover:text-foreground"
                    >
                        <span class="i-mdi-home h-4 w-4"></span>
                        <span class="text-xs tracking-wider uppercase">全部</span>
                    </a>
                    <div class="flex flex-1 min-w-0 justify-end">
                        {next ? (<a
                                href={`/blog/${next.id}/`}
                                class="group text-muted-foreground flex flex-col gap-1 transition-colors items-end hover:text-foreground"
                        >
                            <span class="text-xs tracking-wider inline-flex gap-1 uppercase items-center">
                                下一篇
                                <span class="i-mdi-arrow-right h-3 w-3"/>
                            </span>
                            <span class="text-xs text-foreground font-medium max-w-40 truncate">
                                {next.data.title}
                            </span>
                        </a>) : (<span class="text-xs text-muted-foreground/40 italic">
                            没有下一篇
                        </span>)}
                    </div>
                </nav>
            </div>

            <aside class="hidden lg:block sticky top-20 self-start">
                {tocHeadings.length > 0 && (
                        <>
                            <p class="section-label mb-3">本页目录</p>
                            <Toc client:load headings={tocHeadings}/>
                        </>)}
            </aside>
        </div>
    </div>
</Layout>
