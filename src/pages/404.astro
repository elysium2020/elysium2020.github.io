---
import Layout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader';
import EmptyState from '@/components/EmptyState';
---

<Layout pageTitle="404 · 页面走失了" description="页面不存在">
    <div class="page-narrow">
        <PageHeader eyebrow="Error 404" title="页面走失了"/>

        <EmptyState
                icon="i-mdi-compass-off-outline"
                title="你要找的内容不存在，或已被移动。"
                hint="检查链接是否正确，或返回首页继续浏览。"
        />

        <div class="text-center">
            <a href="/" class="link-accent font-mono text-sm">← 回到首页</a>
        </div>
    </div>
</Layout>
