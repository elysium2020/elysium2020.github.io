---
import TagLink from "@/components/TagLink";

const {post, formatDate} = Astro.props;
---

<a
        href={`/blog/${post.id}`}
        class="group px-3 py-4 border-t border-border rounded-sm flex gap-6 transition-colors items-baseline -mx-3 last:border-b hover:bg-accent/20"
>
    <time
            class="date-text min-w-16"
    >
        {formatDate(post.data.pubDate)}
    </time>

    <div class="flex flex-1 flex-col gap-1.5 min-w-0">
        <span class="text-sm text-foreground leading-snug font-medium">
            {post.data.title}
        </span>

        <span
                class="text-xs text-muted-foreground leading-relaxed line-clamp-1"
        >
            {post.data.description}
        </span>

        {post.data.tags.length > 0 && (
                <div class="mt-0.5 flex flex-wrap gap-1.5">
                    {post.data.tags.slice(0, 3).map((tag: string) => (
                            <TagLink tag={tag}/>))}
                </div>)}
    </div>
</a>
