---
// src/components/SiteHeader.astro —— 站点顶栏：品牌 + 桌面导航 + 主题/移动菜单岛
import { NAV_ITEMS, SITE } from "@/lib/site";
import ThemeToggle from "@/components/islands/ThemeToggle.tsx";
import MobileNav from "@/components/islands/MobileNav.tsx";

const currentPath = Astro.url.pathname;
---

<header
        class="border-b border-border bg-background/95 top-0 sticky z-40 backdrop-blur supports-[backdrop-filter]:bg-background/60"
>
    <nav
            class="mx-auto px-6 flex h-15 max-w-5xl items-center justify-between"
            aria-label="主导航"
    >
        <a
                href="/"
                aria-current={currentPath === "/" ? "page" : undefined}
                class="font-mono text-lg text-foreground tracking-tight font-bold flex gap-1.5 transition-opacity items-baseline hover:opacity-70"
        >
            {SITE.title}
        </a>
        <div class="flex items-center gap-1">
            <ul class="hidden items-center md:flex">
                {NAV_ITEMS.map((item) => {
                    const isActive = currentPath.startsWith(item.href);
                    return (
                            <li>
                                <a
                                        href={item.href}
                                        aria-current={isActive ? "page" : undefined}
                                        class:list={["font-mono relative px-4 py-2 text-sm tracking-widest uppercase transition-colors", isActive ? "text-foreground" : "text-muted-foreground hover:text-foreground",]}
                                >
                                    {item.title}
                                    {isActive && (
                                            <span class="rounded-full bg-accent h-px bottom-1 left-4 right-4 absolute"/>)}
                                </a>
                            </li>);
                })}
            </ul>
            <div class="hidden md:block">
                <ThemeToggle client:idle/>
            </div>
            <MobileNav client:idle/>
        </div>
    </nav>
</header>
