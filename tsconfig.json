{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "paths": { "@/*": ["./src/*"] },
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "checkJs": true,
    "allowJs": true,
    "plugins": [{ "name": "@astro/ts-plugin" }]
  }
}
